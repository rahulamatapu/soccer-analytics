# Copy to .env and adjust. .env is gitignored.
# One of: dev | test | demo
APP_ENV=dev

# --- Kafka ---
KAFKA_BOOTSTRAP=kafka:9092
KAFKA_TOPIC=live-match-events

# --- Postgres ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=momentum_dev
POSTGRES_USER=momentum
POSTGRES_PASSWORD=change-me

# --- Spark streaming ---
CHECKPOINT_ROOT=/checkpoints
WINDOW_DURATION=5 minutes
WINDOW_SLIDE=1 minute
WATERMARK=2 minutes
TRIGGER_INTERVAL=10 seconds

# --- Momentum score weights ---
W_FINAL_THIRD=1.0
W_SHOT=3.0
W_XG=5.0
W_TACKLE=0.5

# --- Producer (2022 World Cup Final: Argentina v France) ---
COMPETITION_ID=43
SEASON_ID=106
MATCH_ID=3869685
SPEED=30
LATE_PROB=0.03
LATE_MAX_SECONDS=180

